{
  "$comment": "Single source of truth for the visual system. `python design/build_tokens.py` regenerates app/src/styles/tokens.css. Brand values are placeholders until phase 7.",
  "brand": {
    "name": "LocalFlow",
    "tagline": "Speak. It's typed."
  },
  "color": {
    "light": {
      "ground": "#F7F6FB",
      "surface": "#FFFFFF",
      "surface-2": "#F0EEF8",
      "ink": "#1B1A2E",
      "ink-2": "#4A4766",
      "muted": "#6E6B8A",
      "line": "#DCD8EE",
      "line-2": "#EAE7F5",
      "accent": "#6B4FE6",
      "accent-ink": "#4E36C2",
      "accent-soft": "#ECE8FB",
      "rec": "#E5484D",
      "good": "#1E9A66",
      "warn": "#B7771A",
      "danger": "#C8362E"
    },
    "dark": {
      "ground": "#131222",
      "surface": "#1B1A2D",
      "surface-2": "#232238",
      "ink": "#ECEAF6",
      "ink-2": "#C3C0DA",
      "muted": "#9A97B8",
      "line": "#302E48",
      "line-2": "#272539",
      "accent": "#A08DFF",
      "accent-ink": "#B8A9FF",
      "accent-soft": "#2A2547",
      "rec": "#FF5F64",
      "good": "#4CC58F",
      "warn": "#E0A64A",
      "danger": "#F0625A"
    },
    "bar": {
      "$comment": "The flow bar is always dark so it reads over any app.",
      "bg": "rgba(23, 23, 28, 0.92)",
      "border": "rgba(255, 255, 255, 0.08)",
      "ink": "#ECECF1",
      "dim": "#6B6B76",
      "wave": "#8B6CFF",
      "wave-tip": "#ECECF1",
      "rec": "#FF4D4F",
      "good": "#3DDC84",
      "shadow": "0 8px 28px rgba(0, 0, 0, 0.45)"
    },
    "tray": {
      "idle": "#6B4FE6",
      "recording": "#FF4D4F",
      "loading": "#6B6B76",
      "error": "#B7771A"
    }
  },
  "type": {
    "display": "\"Bricolage Grotesque\", \"Segoe UI Variable Display\", \"Segoe UI\", system-ui, sans-serif",
    "body": "\"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif",
    "mono": "\"Cascadia Mono\", Consolas, \"IBM Plex Mono\", monospace",
    "scale": { "xs": 12, "sm": 13, "md": 14, "lg": 16, "xl": 20, "2xl": 26, "3xl": 34 },
    "line-height": { "tight": 1.2, "base": 1.5 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "radius": { "sm": 6, "md": 10, "lg": 14, "pill": 999 },
  "motion": {
    "fast-ms": 120,
    "base-ms": 200,
    "slow-ms": 320,
    "ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "spring": { "stiffness": 260, "damping": 22, "mass": 1 }
  },
  "bar": {
    "width": 236,
    "height": 48,
    "bottom-gap": 28,
    "bar-count": 22,
    "bar-min": 4,
    "bar-max": 30,
    "level-attack": 0.6,
    "level-release": 0.25,
    "fps": 60,
    "linger-ms": 600
  },
  "sound": {
    "start": [660, 880],
    "stop": [880, 660],
    "error": [220],
    "tone-ms": 70,
    "volume": 0.25
  }
}
